# Copy this file to .env for local development.
# Do not commit real API keys.
OPENAI_API_KEY=

# INDmoney MCP endpoint
MCP_SERVER_URL=https://mcp.indmoney.com/mcp

# Firebase project used by Cloud Firestore (local Docker development)
GOOGLE_CLOUD_PROJECT=YOUR_FIREBASE_PROJECT_ID

# Public Firebase Hosting origin. Set this to the local browser origin for development.
APP_ORIGIN=http://localhost:8003

# Cloud Run server port (Cloud Run sets PORT automatically in production).
PORT=8080
