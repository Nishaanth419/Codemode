# Copy this file to .env for local development.
# Do not commit real API keys.
OPENAI_API_KEY=

# INDmoney MCP endpoint
MCP_SERVER_URL=https://mcp.indmoney.com/mcp

# Public Firebase Hosting origin. Use http://localhost:8080 for local development.
APP_ORIGIN=http://localhost:8080

# Cloud Run server port (Cloud Run sets PORT automatically in production).
PORT=8080
