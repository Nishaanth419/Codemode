# ─────────────────────────────────────────────────────────────────────────────
# AgentOS configuration. Copy to .env and fill in at least one LLM provider.
# All keys stay on the server (workers/agent); the browser never sees them.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM providers ────────────────────────────────────────────────────────────
# Primary: Groq (OpenAI-compatible API, https://api.groq.com/openai/v1)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback: Google Gemini (official @google/genai SDK). Stable Flash model with
# function calling + structured output. (gemini-2.5-flash is deprecated.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional local provider: Ollama (OpenAI-compatible endpoint). Appended to the
# chain after primary/fallback when enabled, or set it as primary/fallback.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gpt-oss:20b

# Routing
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
LLM_AUTO_FAILOVER=true
LLM_REQUEST_TIMEOUT_MS=60000
# Bounded retries on the same provider for transient errors (5xx, timeouts, network)
LLM_MAX_RETRIES=2
# Longest Retry-After we wait on the same provider before failing over instead
LLM_MAX_RETRY_WAIT_MS=8000
LLM_MAX_AGENT_STEPS=8

# ── Code Mode executor ───────────────────────────────────────────────────────
# local  = worker-thread V8 isolate (development adapter, fast)
# docker = locked-down container per program (stronger isolation)
# Neither is Cloudflare's managed DynamicWorkerExecutor (needs Workers + Worker Loader).
CODEMODE_EXECUTOR=local
# Limit on the program's own run time; time waiting on host tools is not counted
CODEMODE_TIMEOUT_MS=30000
# Hard cap on total wall time per execution, host tools included
CODEMODE_MAX_WALL_MS=300000
CODEMODE_MEMORY_MB=128

# ── Docker sandbox (Python / Node.js / shell) ───────────────────────────────
SANDBOX_IMAGE=agentos-sandbox:latest
SANDBOX_TIMEOUT_MS=20000
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
SANDBOX_PIDS_LIMIT=64
# manager:name entries; pip:* or npm:* would allow anything (not recommended)
SANDBOX_ALLOWED_PACKAGES=pip:requests,pip:numpy,pip:pandas,pip:matplotlib,pip:pyyaml,pip:beautifulsoup4,pip:python-dateutil,npm:lodash,npm:dayjs,npm:zod,npm:csv-parse,npm:yaml,npm:marked

# ── MCP servers ──────────────────────────────────────────────────────────────
# Each server's tools become a typed namespace that Code Mode programs call
# (e.g. everything.get_sum(...)); the LLM still sees only the codemode tool.
# Config file in the mcpServers format (path relative to the repo root). The
# bundled mcp.json starts the keyless demo server with npx. Remove to disable MCP.
MCP_CONFIG_FILE=mcp.json
# Inline JSON in the same format; entries override the file's by name, e.g.
# MCP_SERVERS={"docs":{"url":"https://example.com/mcp","headers":{"Authorization":"Bearer ${DOCS_TOKEN}"}}}
# ${VAR} placeholders in args/env/url/headers are filled from this file, so put
# server tokens here (e.g. GITHUB_PERSONAL_ACCESS_TOKEN=) and reference them.
# Spawn / connect + handshake + first tools/list, per attempt
MCP_CONNECT_TIMEOUT_MS=30000
# Default limit for one MCP tool call (a server's "timeoutMs" overrides it)
MCP_CALL_TIMEOUT_MS=60000
# Longest wait between reconnect attempts to a failed server
MCP_RECONNECT_MAX_MS=60000

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# DATA_DIR=./.data
# Only when the agent runs inside Docker: host path of DATA_DIR for sibling sandbox mounts
# WORKSPACE_HOST_DIR=
