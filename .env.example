# Copy this file to .env for local development.
# Do not commit real API keys.
OPENAI_API_KEY=

# INDmoney MCP endpoint
MCP_SERVER_URL=https://mcp.indmoney.com/mcp

# Local app origin (OAuth callback uses this exact address).
APP_ORIGIN=http://localhost:8003

# Port inside the local Docker container.
PORT=8080
