{
  "name": "@agentos/agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/shims/register.ts src/index.ts",
    "start": "tsx --import ./src/shims/register.ts src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/smoke/**'",
